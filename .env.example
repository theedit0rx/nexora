# ==========================================================================
# NEXORA — Autonomous Digital Agency OS
# Environment template. NEVER commit real credentials.
# Copy to `.env` (or `.env.local`) and fill in only what you need.
# Everything is optional: NEXORA runs fully in Demo Mode without any keys.
# ==========================================================================

# --------------------------------------------------------------------------
# CORE
# --------------------------------------------------------------------------
# Public URL of the deployment (used for preview links, outreach links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required secret used to sign local session tokens (at least 32 random characters)
NEXORA_SESSION_SECRET=

# Set to `demo` to force demo mode, `live` to force live mode.
# Leave empty to auto-detect (demo when no database is connected).
NEXORA_MODE=

# --------------------------------------------------------------------------
# SUPABASE  (PostgreSQL + Auth + Storage + RLS)
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# AI PROVIDERS  (provider abstraction — configure any subset)
# --------------------------------------------------------------------------
# NEXORA's own gateway key (optional). Prefer provider keys below.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Which provider the agents use by default: openai | anthropic | google | openrouter | gateway | local
NEXORA_AI_PROVIDER=local

# --------------------------------------------------------------------------
# LEAD SOURCES
# --------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
LEAD_SEARCH_PROVIDER=serp
LEAD_SEARCH_API_KEY=

# --------------------------------------------------------------------------
# EMAIL  (gmail | resend | smtp)
# --------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=NEXORA <hello@yourdomain.com>

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --------------------------------------------------------------------------
# WHATSAPP BUSINESS  (official Cloud API only — no unofficial automation)
# --------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --------------------------------------------------------------------------
# GITHUB  (repository provider)
# --------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ORG=

# --------------------------------------------------------------------------
# VERCEL  (deployment provider)
# --------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --------------------------------------------------------------------------
# PAYMENTS
# --------------------------------------------------------------------------
PAYMENT_PROVIDER_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# GENERATED SITE STORAGE (production deployments)
# --------------------------------------------------------------------------
# local | vercel-blob | supabase-storage
SITE_STORAGE_PROVIDER=local
